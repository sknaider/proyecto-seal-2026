{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seal.local/schemas/nerves_integrity_evidence_v1.schema.json",
  "title": "SEAL NERVES JARVIS integrity evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "classification",
    "read_only",
    "summary",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "seal.nerves.integrity-evidence.v1"
    },
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "classification": {
      "type": "string",
      "enum": [
        "healthy",
        "real_regression",
        "owner_unobservable",
        "instrument_unavailable",
        "inconclusive",
        "abstained_scope_invalid"
      ]
    },
    "read_only": {
      "const": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "argv",
          "returncode",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_tail",
          "stderr_tail"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "returncode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout_tail": {
            "type": "string",
            "maxLength": 4000
          },
          "stderr_tail": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
