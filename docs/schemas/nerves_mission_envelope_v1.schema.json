{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seal.local/schemas/nerves_mission_envelope_v1.schema.json",
  "title": "SEAL NERVES MissionEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "idempotency_key",
    "agent",
    "tenant_id",
    "nerve_fire_id",
    "nerve_layer",
    "drive",
    "specialty",
    "objective",
    "risk_class",
    "source_refs",
    "initiation_conditions",
    "scope",
    "skills",
    "allowed_tools",
    "budgets",
    "expected_evidence",
    "termination_conditions",
    "rollback",
    "builder",
    "verifier"
  ],
  "properties": {
    "schema": {"const": "seal.nerves.mission.v1"},
    "mission_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 160},
    "agent": {
      "type": "string",
      "enum": ["ADA", "ALICE", "DUM", "JARVIS", "NEXUS", "FABLE"]
    },
    "tenant_id": {"type": "string", "format": "uuid"},
    "nerve_fire_id": {"type": "string", "minLength": 8},
    "correlation_id": {"type": ["string", "null"]},
    "nerve_layer": {
      "type": "string",
      "enum": ["GLOBAL", "AGENT_ROLE", "EMERGENT"]
    },
    "drive": {
      "type": "string",
      "enum": ["reactive", "proactive"]
    },
    "specialty": {"type": "string", "minLength": 3, "maxLength": 120},
    "objective": {"type": "string", "minLength": 10, "maxLength": 2000},
    "risk_class": {
      "type": "string",
      "enum": [
        "A1_REFLEX",
        "A2_READ_ONLY",
        "A3_REVERSIBLE_WRITE",
        "A4_SERVICE_CHANGE",
        "A5_GOVERNED",
        "A6_DESTRUCTIVE"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 500}
    },
    "initiation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "paths", "services", "network"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "services": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "network": {"type": "string", "enum": ["none", "allowlist"]}
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "max_attempts", "token_budget"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "token_budget": {"type": "integer", "minimum": 256, "maximum": 200000}
      }
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "termination_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "plan"],
      "properties": {
        "required": {"type": "boolean"},
        "plan": {"type": "string"}
      }
    },
    "builder": {"type": "string", "minLength": 3},
    "verifier": {"type": "string", "minLength": 3},
    "confidence_prior": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
