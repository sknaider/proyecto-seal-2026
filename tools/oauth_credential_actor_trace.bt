/*
 * Passive attribution tracer for the shared Claude OAuth credential store.
 *
 * Security contract:
 * - metadata only: PID/TID/UID/cgroup-id/comm/syscall/path/flags;
 * - never reads or prints credential bytes;
 * - restricted to uid 1000 and paths containing ".credentials.json";
 * - intended to identify which existing runtime performs the next real refresh.
 */

BEGIN
{
  time("%F %T %z ");
  printf("TRACE_READY scope=uid1000 path=.credentials.json metadata_only=true\n");
}

tracepoint:syscalls:sys_enter_openat
/uid == 1000 && strcontains(str(args.filename), ".credentials.json")/
{
  time("%F %T %z ");
  printf("pid=%d tid=%d uid=%d cgroup=%llu scope=%s comm=%s op=openat path=%s flags=%d\n",
         pid, tid, uid, cgroup, cgroup_path(cgroup), comm, str(args.filename), args.flags);
}

tracepoint:syscalls:sys_enter_openat2
/uid == 1000 && strcontains(str(args.filename), ".credentials.json")/
{
  time("%F %T %z ");
  printf("pid=%d tid=%d uid=%d cgroup=%llu scope=%s comm=%s op=openat2 path=%s\n",
         pid, tid, uid, cgroup, cgroup_path(cgroup), comm, str(args.filename));
}

tracepoint:syscalls:sys_enter_renameat
/uid == 1000 && (strcontains(str(args.oldname), ".credentials.json") ||
                 strcontains(str(args.newname), ".credentials.json"))/
{
  time("%F %T %z ");
  printf("pid=%d tid=%d uid=%d cgroup=%llu scope=%s comm=%s op=renameat old=%s new=%s\n",
         pid, tid, uid, cgroup, cgroup_path(cgroup), comm, str(args.oldname), str(args.newname));
}

tracepoint:syscalls:sys_enter_renameat2
/uid == 1000 && (strcontains(str(args.oldname), ".credentials.json") ||
                 strcontains(str(args.newname), ".credentials.json"))/
{
  time("%F %T %z ");
  printf("pid=%d tid=%d uid=%d cgroup=%llu scope=%s comm=%s op=renameat2 old=%s new=%s flags=%d\n",
         pid, tid, uid, cgroup, cgroup_path(cgroup), comm, str(args.oldname), str(args.newname), args.flags);
}

tracepoint:syscalls:sys_enter_unlinkat
/uid == 1000 && strcontains(str(args.pathname), ".credentials.json")/
{
  time("%F %T %z ");
  printf("pid=%d tid=%d uid=%d cgroup=%llu scope=%s comm=%s op=unlinkat path=%s flags=%d\n",
         pid, tid, uid, cgroup, cgroup_path(cgroup), comm, str(args.pathname), args.flag);
}

END
{
  time("%F %T %z ");
  printf("TRACE_STOP\n");
}
