{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soul App",
  "version": "0.4.0",
  "identifier": "ai.seal.companion",
  "build": {
    "frontendDist": "../companion_core/ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix companion_core/ui run dev",
    "beforeBuildCommand": "npm --prefix companion_core/ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Soul App",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
