#!/usr/bin/env bash
set -e

DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/seal-app"
VENV_DIR="$DATA_ROOT/venv"
APP_DIR="/usr/share/seal-companion"
UI_URL="http://127.0.0.1:8769/"

# Create venv or upgrade deps when VERSION file changes
VERSION_FILE="$VENV_DIR/.seal_companion_version"
CURRENT_VERSION="0.3.0"
if [ ! -d "$VENV_DIR" ] || [ "$(cat "$VERSION_FILE" 2>/dev/null)" != "$CURRENT_VERSION" ]; then
    mkdir -p "$DATA_ROOT"
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --quiet -r /usr/share/seal-companion/requirements.txt
    echo "$CURRENT_VERSION" > "$VERSION_FILE"
fi

# Start companion_core :8769 in background if not already running.
if ! curl -sf http://127.0.0.1:8769/api/health > /dev/null 2>&1; then
    "$VENV_DIR/bin/uvicorn" companion_core.main:app \
        --host 127.0.0.1 --port 8769 \
        --app-dir "$APP_DIR" \
        --log-level warning &
fi

# Wait for it to be ready
for i in $(seq 1 20); do
    curl -sf http://127.0.0.1:8769/api/health > /dev/null 2>&1 && break
    sleep 0.3
done

# Launch the packaged web UI. The backend serves /usr/share/seal-companion/ui.
if command -v brave-browser >/dev/null 2>&1; then
    exec brave-browser --app="$UI_URL" --window-size=1060,720 "$@"
elif command -v chromium-browser >/dev/null 2>&1; then
    exec chromium-browser --app="$UI_URL" --window-size=1060,720 "$@"
elif command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$UI_URL"
else
    echo "SEAL Companion is running at $UI_URL"
fi
