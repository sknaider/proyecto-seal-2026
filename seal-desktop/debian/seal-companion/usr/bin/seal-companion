#!/usr/bin/env bash
set -e

COMPANION_DIR="$(dirname "$(readlink -f "$0")")"
VENV_DIR="$HOME/.seal/venv"
CORE_DIR="/usr/share/seal-companion/companion_core"

# Create venv or upgrade deps when VERSION file changes
VERSION_FILE="$VENV_DIR/.seal_companion_version"
CURRENT_VERSION="0.3.0"
if [ ! -d "$VENV_DIR" ] || [ "$(cat "$VERSION_FILE" 2>/dev/null)" != "$CURRENT_VERSION" ]; then
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --quiet fastapi uvicorn aiosqlite pydantic httpx anthropic
    echo "$CURRENT_VERSION" > "$VERSION_FILE"
fi

# Start companion_core :8769 in background
"$VENV_DIR/bin/uvicorn" companion_core.main:app \
    --host 127.0.0.1 --port 8769 \
    --app-dir "$CORE_DIR" \
    --log-level warning &
CORE_PID=$!

# Wait for it to be ready
for i in $(seq 1 20); do
    curl -sf http://127.0.0.1:8769/api/health > /dev/null 2>&1 && break
    sleep 0.3
done

# Launch Tauri app
exec /usr/bin/seal-companion-app "$@"

# Cleanup on exit
kill $CORE_PID 2>/dev/null || true
