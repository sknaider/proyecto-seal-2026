{
  "schema": "seal.quality-policy.v1",
  "policy_id": "william-golden-quality-rule-2026-08-03",
  "independent_review_required": true,
  "required_qa_arms": [
    "unit",
    "qa_positive",
    "qa_negative",
    "qa_control"
  ],
  "source_suffixes": [
    ".py", ".sh", ".bash", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs",
    ".java", ".c", ".h", ".cc", ".cpp", ".cs", ".rb", ".php", ".sql"
  ],
  "source_filenames": ["Dockerfile", "Makefile", "Justfile"],
  "known_defect_patterns": "quality/known-defect-patterns.json",
  "critical_paths": [
    "memory/**",
    "messages/**",
    "quality_gate/**",
    "scripts/seal_*guard.py",
    "scripts/seal_quality_gate.py",
    "**/*auth*.py",
    "**/*credential*.py",
    "**/*permission*.py"
  ],
  "thresholds": {
    "coverage_floor_percent": 0.0,
    "critical_mutation_score_percent": 69.590,
    "committed_test_ratio_floor": 0.541958
  },
  "required_tracked_paths": [
    "quality/policy.json",
    "quality/SEAL_QUALITY_GOLDEN_RULE.md",
    "quality_gate/__init__.py",
    "quality_gate/gate.py",
    "quality_gate/tests/test_gate.py",
    "scripts/seal_quality_gate.py",
    "quality/requirements.lock",
    "quality/known-defect-patterns.json",
    "quality/mutation-baseline.json",
    "quality/manifests/quality-gate-bootstrap.json",
    "setup.cfg",
    ".githooks/pre-commit",
    ".github/workflows/seal-quality-gate.yml",
    ".github/CODEOWNERS"
  ],
  "manifests": [
    "quality/manifests/quality-gate-bootstrap.json",
    "quality/manifests/soul-f1-runtime-hooks.json",
    "quality/manifests/soul-f2-runtime-orchestrator.json",
    "quality/manifests/soul-f3-runtime-parity.json"
  ]
}
