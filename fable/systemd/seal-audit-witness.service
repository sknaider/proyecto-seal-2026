[Unit]
Description=SEAL external monotonic audit witness
After=local-fs.target

[Service]
Type=simple
User=seal-audit-witness
Group=seal-audit-witness
SupplementaryGroups=seal-audit-client
ExecStart=/opt/seal/mcp-web-soul/current/bin/python3 /usr/local/libexec/seal/mcp_web_soul_witness.py --socket /run/seal-audit-witness/witness.sock --db /var/lib/seal-audit-witness/witness.sqlite3 --socket-group seal-audit-client --allow-user seal-mcp-web-operator --allow-user seal-mcp-web-cdp --bind-stream seal-mcp-web-operator=audit:0cf0c41fefd3040587ddb86fec62bb6cbc9b23913b01e2928958f58b59c13b67 --bind-stream seal-mcp-web-cdp=audit:4f292c4bb17ea06a28c7fe13d4084c1a012c63dc041508749403b15ff5063054
Restart=on-failure
RestartSec=1
UMask=0077
RuntimeDirectory=seal-audit-witness
RuntimeDirectoryMode=0750
StateDirectory=seal-audit-witness
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
