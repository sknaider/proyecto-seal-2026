[Unit]
Description=SOUL Memory SDK API canonical service — localhost :8768
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dadito/IA/proyecto-seal/memory
Environment=PYTHONPATH=/home/dadito/IA/proyecto-seal/memory
ExecStart=/usr/bin/python3 -m uvicorn soul_memory_sdk_api:app --host 127.0.0.1 --port 8768
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
