# SEAL Memory System — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_USER=seal
PG_PASSWORD=seal_memory_2026
PG_DATABASE=seal_memory
PG_POOL_MIN=1
PG_POOL_MAX=3

# ── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=soul_memories

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=seal2026soul

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# ── Web Chat Bridge ─────────────────────────────────────────────────────────
WEB_CHAT_HOST=localhost
WEB_CHAT_PORT=8765

# ── Soul Mode ───────────────────────────────────────────────────────────────
# Set to true to use PostgreSQL+pgvector only (no Qdrant, no Neo4j)
SOUL_LITE=false
