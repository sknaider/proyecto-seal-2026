    "required_before_live": [
      "durable_action_ledger",
      "per_agent_lease",
      "idempotency_key",
      "attention_gate",
      "budget_gate",
      "safety_gate",
      "egress_gate",
      "tool_scope",
      "result_evidence",
      "dead_letter_recovery",
      "independent_soak"
    ]
  },
  "evidence": {
    "contract_report": "research/flywire_results/nerves_contract_verification.json",
    "shared_e2e_report": "research/flywire_results/nerves_e2e_canary.json",
    "shared_activation_report": "research/flywire_results/nerves_activation_canary.json",
