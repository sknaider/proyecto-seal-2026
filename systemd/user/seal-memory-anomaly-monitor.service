[Unit]
Description=NEXUS SEAL Memory Anomaly Monitor — OWASP LLM01+LLM08 detection layer
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/dadito/IA/proyecto-seal/sandbox-agent
ExecStart=/home/dadito/IA/seal-spark/.venv/bin/python3 /home/dadito/IA/proyecto-seal/sandbox-agent/seal_memory_anomaly_monitor.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=SEAL_REQUIRE_DEDICATED_OPERATIONAL_DSN=1
Environment=SEAL_MEMORY_MONITOR_PG_DSN_FILE=/home/dadito/.config/seal/postgres-services/seal-memory-monitor.dsn
RuntimeDirectory=seal-memory-anomaly-monitor
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/dadito/IA/proyecto-seal
ReadOnlyPaths=/home/dadito/.config/seal/postgres-services/seal-memory-monitor.dsn
ReadWritePaths=/home/dadito/IA/proyecto-seal/sandbox-agent/logs
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=append:/home/dadito/IA/proyecto-seal/sandbox-agent/logs/memory_anomaly_monitor.log
StandardError=append:/home/dadito/IA/proyecto-seal/sandbox-agent/logs/memory_anomaly_monitor.log

[Install]
WantedBy=default.target
