[Unit]
Description=ALICE ORION nerve — product healthcheck by effect
After=network-online.target orion-exam.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dadito/IA/proyecto-seal/agents/ALICE/orion
ExecStart=/home/dadito/IA/seal-spark/.venv/bin/python3 /home/dadito/IA/proyecto-seal/agents/ALICE/orion/orion_nerve.py
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Nice=10
StandardOutput=journal
StandardError=journal
