[Unit]
Description=SEAL Studio backend (FastAPI/uvicorn) — :8800
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dadito/IA/proyecto-seal/seal-studio/backend
EnvironmentFile=/home/dadito/.config/seal-studio/backend.env
ExecStart=/home/dadito/IA/seal-spark/.venv/bin/python3 /home/dadito/IA/seal-spark/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8800
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
