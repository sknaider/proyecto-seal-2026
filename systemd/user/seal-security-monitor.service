[Unit]
Description=NEXUS SEAL Security Monitor — automatic defenses daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dadito/IA/proyecto-seal/sandbox-agent
ExecStart=/usr/bin/python3 /home/dadito/IA/proyecto-seal/sandbox-agent/seal_security_monitor.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/dadito/IA/proyecto-seal
ReadWritePaths=/home/dadito/IA/proyecto-seal/sandbox-agent/logs
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
StandardOutput=append:/home/dadito/IA/proyecto-seal/sandbox-agent/logs/security_monitor.log
StandardError=append:/home/dadito/IA/proyecto-seal/sandbox-agent/logs/security_monitor.log

[Install]
WantedBy=default.target
