[Unit]
Description=ALICE kernel soul — runtime daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dadito
Group=dadito
WorkingDirectory=/home/dadito/IA/proyecto-seal/sandbox-agent/ALICE
Environment="PYTHONUNBUFFERED=1"
Environment="ALICE_HEALTH_INTERVAL=900"
Environment="ALICE_POLL_INTERVAL=3.0"
ExecStart=/usr/bin/python3 /home/dadito/IA/proyecto-seal/sandbox-agent/ALICE/alice_daemon.py
ExecStop=/usr/bin/python3 /home/dadito/IA/proyecto-seal/sandbox-agent/ALICE/alice_daemon.py --stop
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/dadito/IA/proyecto-seal/sandbox-agent/ALICE/logs/alice-kernel-soul.log
StandardError=append:/home/dadito/IA/proyecto-seal/sandbox-agent/ALICE/logs/alice-kernel-soul.err

[Install]
WantedBy=default.target
